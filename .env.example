# 企业智能售后服务 Agent 环境变量示例
# 复制为 .env 后按需修改；真实密钥只保留在受控环境，不得写入版本库。
# 运行参数的唯一数值定义源为《技术详细规格》1.4 全局参数表。

# ---------- 应用环境 ----------
# development / test / production
APP_ENV=development

# ---------- 模型适配器 ----------
# 生产默认私有模型端点；开发经批准可使用云API，且只处理合成数据
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---------- Optional local WooCommerce REST API acceptance ----------
# Keep blank to skip the live WooCommerce integration test. Use a local test store only.
WOO_STORE_URL=http://localhost:8088
WOO_ORDER_QUERIES_ENABLED=false
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_TEST_ORDER_ID=
WOO_TEST_TENANT_ID=
WOO_TEST_REFUND_AMOUNT=
# Set true only when the selected test order is safe to mutate. Refund API uses api_refund=false.
WOO_ENABLE_REFUND_WRITE=false
# Required by the application profile; set a private key before startup and never commit it.
ADDRESS_ENCRYPT_KEY=
LLM_TOOL_CHOICE=auto
LLM_TEMPERATURE=0.2

# ---------- Agent 安全边界（技术详细规格 1.4） ----------
AGENT_MAX_STEPS=8
TOOL_MAX_RETRIES=1

# ---------- MCP 服务 ----------
# API/Worker 通过该地址访问独立 MCP 进程
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# MCP 进程自身监听地址
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# ---------- MySQL（长期记忆、Checkpoint、审计、Outbox 等模块表） ----------
MYSQL_URL=mysql+pymysql://after_sales:change-me@localhost:3306/after_sales

# ---------- Redis（会话记忆） ----------
REDIS_URL=redis://localhost:6379/0
# 生产必须为 false；开发/测试仅显式 true 时允许内存降级且健康状态标记 degraded
MEMORY_FALLBACK_ENABLED=false

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://after_sales:change-me@localhost:5672/

# ---------- Neo4j（知识图谱） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_QUERY_USERNAME=knowledge_reader
# 由本机环境变量或秘密管理服务注入，勿提交实际密码。
NEO4J_QUERY_PASSWORD=
KNOWLEDGE_LOCAL_TOOLS_ENABLED=false
# 注意：Neo4j 5 数据库名不允许下划线；规格 13 章的 after_sales_knowledge 需修订，
# 实际使用连字符命名（见开发运行指南步骤05记录）。
NEO4J_DATABASE=after-sales-knowledge
NEO4J_READ_ONLY=true

# ---------- 向量检索（开发默认 Chroma；生产 Milvus） ----------
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/generated/chroma
# 技术详细规格 1.4：Embedding 模型与维度为硬契约
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512

# ---------- API 进程 ----------
API_HOST=127.0.0.1
API_PORT=8000
