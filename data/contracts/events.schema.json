{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:after-sales-agent:event-envelope:v1",
  "title": "Versioned integration event envelope",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "event_version",
    "tenant_id",
    "request_id",
    "correlation_id",
    "trace_id",
    "operation_id",
    "causation_id",
    "parent_event_id",
    "producer",
    "occurred_at",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{2,127}$",
      "enum": [
        "ticket.created",
        "order.shipping_address.updated",
        "ticket.updated",
        "human.handoff.created",
        "notification.created",
        "refund.confirmed",
        "knowledge.updated",
        "agent.task.created",
        "tool.call.failed",
        "audit.record.created",
        "return.created",
        "warehouse.return.received",
        "warehouse.return.inspected",
        "refund.approved",
        "refund.execution.requested",
        "refund.execution.succeeded",
        "refund.execution.failed",
        "ontology.release.activated"
      ]
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ticket.created"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_ticket_created"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "order.shipping_address.updated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_order_shipping_address_updated"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ticket.updated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
