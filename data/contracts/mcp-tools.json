          "investigation_id"
        ],
        "properties": {
          "investigation_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_explain_anomaly"
