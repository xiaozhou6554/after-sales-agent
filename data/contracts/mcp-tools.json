          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_check_shipping_address_change"
    },
    {
      "name": "calculate_refund",
      "owner": "AFTER_SALES",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "refund:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Calculate a server-side quote with line-level amount and currency breakdown.",
      "input_schema": {
        "type": "object",
        "required": [
          "order_id",
          "reason_code",
          "lines"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "order_line_id",
                "quantity"
              ],
              "properties": {
                "order_line_id": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_calculate_refund"
    },
    {
      "name": "create_refund_request",
      "owner": "AFTER_SALES",
      "access": "write",
      "side_effect": "business",
      "auth_scopes": [
        "refund:request"
      ],
      "requires_confirmation": true,
      "idempotency_required": true,
      "description": "Create a pending-review request only after server-bound customer confirmation and one-time verification; confirmation and idempotency are injected from OperationContext, not model arguments.",
      "input_schema": {
        "type": "object",
        "required": [
          "order_id",
          "reason_code"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_create_refund_request"
    },
    {
      "name": "query_refund_request",
      "owner": "AFTER_SALES",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "refund:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Read a refund application and its independent review, return and funds states by request ID; pending operation recovery uses server-injected OperationContext.",
      "input_schema": {
        "type": "object",
        "required": [
          "refund_request_id"
        ],
        "properties": {
          "refund_request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_query_refund_request"
    },
    {
      "name": "create_ticket",
      "owner": "TICKET",
      "access": "write",
      "side_effect": "business",
      "auth_scopes": [
        "ticket:create"
      ],
      "requires_confirmation": true,
      "idempotency_required": true,
      "description": "Create a bounded after-sales ticket from content shown to the user before submission; confirmation and idempotency are injected from OperationContext.",
      "input_schema": {
        "type": "object",
        "required": [
          "title",
          "description",
          "priority"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "priority": {
            "enum": [
              "low",
              "normal",
              "high"
            ]
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_create_ticket"
    },
    {
      "name": "query_ticket",
      "owner": "TICKET",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "ticket:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Read an authorized ticket summary with ownership and tenant checks.",
      "input_schema": {
        "type": "object",
        "required": [
          "ticket_id"
        ],
        "properties": {
          "ticket_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_query_ticket"
    },
    {
      "name": "handoff_to_human",
      "owner": "TICKET",
      "access": "write",
      "side_effect": "business",
      "auth_scopes": [
        "ticket:create"
      ],
      "requires_confirmation": true,
      "idempotency_required": true,
      "description": "Request a human handoff with a bounded summary; the server verifies the current conversation and injects confirmation and idempotency context.",
      "input_schema": {
        "type": "object",
        "required": [
          "reason",
          "summary"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_handoff_to_human"
    },
    {
      "name": "query_after_sales_metrics",
      "owner": "ANALYTICS",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "analytics:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Query versioned product after-sales metrics with source watermarks, quality gates and evidence. return_application_item_rate is an independent metric and must return blocked until its business/finance definition is approved; return_passed_item_rate is the proposed supervisor default and remains non-production until approved.",
      "input_schema": {
        "type": "object",
        "required": [
          "metric_id",
          "cohort_start",
          "cohort_end"
        ],
        "properties": {
          "metric_id": {
            "enum": [
              "return_application_item_rate",
              "return_passed_item_rate",
              "refund_successful_line_rate",
              "refund_goods_amount_rate"
            ]
          },
          "cohort_start": {
            "type": "string",
            "format": "date"
          },
          "cohort_end": {
            "type": "string",
            "format": "date"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "product_id",
                "sku_id",
                "channel",
                "region",
                "warehouse",
                "reason_code"
              ]
            }
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_query_after_sales_metrics"
    },
    {
      "name": "explain_anomaly",
      "owner": "INVESTIGATION",
