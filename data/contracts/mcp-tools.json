    {
      "name": "check_shipping_address_change",
      "owner": "OMS",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "order:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Check address-change eligibility and return the current authorized order revision and denial reasons.",
      "input_schema": {
        "type": "object",
