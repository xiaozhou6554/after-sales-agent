{
  "schema_version": "1.0",
  "manifest_version": 3,
  "response_schema_ref": "data/contracts/mcp-response.schema.json",
  "tools": [
    {
      "name": "query_order",
      "owner": "OMS",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "order:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Read authorized order facts; absent and inaccessible records share one public response.",
      "input_schema": {
        "type": "object",
        "required": [
          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_query_order"
    },
    {
      "name": "query_payment",
      "owner": "PAYMENT",
      "access": "read",
