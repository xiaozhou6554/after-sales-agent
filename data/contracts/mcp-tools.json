      "auth_scopes": [
        "payment:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Read payment and refund execution state from the authoritative payment source.",
      "input_schema": {
        "type": "object",
        "required": [
          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_query_payment"
    },
    {
      "name": "query_tracking",
      "owner": "LOGISTICS",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "logistics:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Read shipment tracking facts by a tracking reference bound to an authorized order.",
      "input_schema": {
        "type": "object",
        "required": [
          "tracking_number"
        ],
        "properties": {
          "tracking_number": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_query_tracking"
    },
    {
      "name": "query_logistics",
      "owner": "LOGISTICS",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "logistics:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Return an authorized shipment summary by order or tracking reference; the server verifies record ownership.",
      "input_schema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "tracking_number": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "order_id"
            ]
          },
          {
            "required": [
              "tracking_number"
            ]
          }
        ],
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_query_logistics"
    },
    {
      "name": "check_delivery_exception",
      "owner": "LOGISTICS",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "logistics:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Read authoritative delivery exception codes and evidence for an authorized order.",
      "input_schema": {
        "type": "object",
        "required": [
          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_check_delivery_exception"
    },
    {
      "name": "search_knowledge_base",
      "owner": "KNOWLEDGE",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "knowledge:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Run vector and BM25 retrieval in parallel against one pinned knowledge release and return evidence references.",
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "release_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_search_knowledge_base"
    },
    {
      "name": "query_knowledge_graph",
      "owner": "KNOWLEDGE",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "knowledge:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Query approved, parameterized knowledge graph relations; arbitrary Cypher is never accepted.",
      "input_schema": {
        "type": "object",
        "required": [
          "entity_names",
          "relation_types"
        ],
        "properties": {
          "entity_names": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "relation_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "enum": [
                "BELONGS_TO",
                "HAS_VERSION",
                "HAS_ACCESSORY",
                "COMPATIBLE_WITH",
                "NOT_COMPATIBLE_WITH",
                "HAS_FEATURE",
                "SUITABLE_FOR",
                "HAS_FAULT_SYMPTOM",
                "SUGGESTS_SERVICE",
                "HAS_POLICY",
                "APPLIES_TO",
                "CONTAINS_CLAUSE",
                "HAS_WARRANTY",
                "SUPPORTED_BY",
                "DESCRIBES",
                "RELATED_TO"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_query_knowledge_graph"
    },
    {
      "name": "search_hybrid_knowledge",
      "owner": "KNOWLEDGE",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "knowledge:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Run version-pinned RAG and KG retrieval in parallel, preserve route evidence, and report conflicts.",
      "input_schema": {
        "type": "object",
        "required": [
          "query",
          "entity_names",
          "relation_types"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "entity_names": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "relation_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "enum": [
                "COMPATIBLE_WITH",
                "HAS_POLICY",
                "HAS_FAULT",
                "HAS_REMEDY",
                "APPLIES_TO"
              ]
            }
          },
          "release_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_search_hybrid_knowledge"
    },
    {
      "name": "get_policy_detail",
      "owner": "KNOWLEDGE",
      "access": "read",
      "side_effect": "none",
      "auth_scopes": [
        "knowledge:read"
      ],
      "requires_confirmation": false,
      "idempotency_required": false,
      "description": "Read a versioned policy by exact name, alias, or stable ID and effective date; ambiguous names require clarification.",
      "input_schema": {
        "type": "object",
        "oneOf": [
          {"required": ["policy_name"]},
          {"required": ["policy_id"]}
        ],
        "properties": {
          "policy_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "policy_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "response_schema_ref": "data/contracts/mcp-response.schema.json#/$defs/tool_data_get_policy_detail"
    },
    {
